enum Dir : U8
  North
  East
  South
  West

  def opposite -> Dir
    case self
    when .North then .South
    when .South then .North
    when .East then .West
    when .West then .East
    end
  end

  def vertical? -> Bool
    case self
    when .North, .South then true
    else false
    end
  end
end

enum Status
  Ok = 200
  NotFound = 404
end

def describe(n: Int) -> String
  case n
  when 0 then "zero"
  when 1..9 then "digit"
  when 10, 20, 30 then "round"
  else "other"
  end
end

def main
  d: Dir = .East
  p d
  puts d
  puts d.opposite
  puts d.vertical?
  puts Dir.North.vertical?
  puts d == .East
  puts d.to_i
  s = Status.NotFound
  puts s.to_i
  puts describe(0)
  puts describe(7)
  puts describe(20)
  puts describe(99)
  case d
  when .North
    puts "up"
  when .East, .West
    puts "sideways"
  when .South
    puts "down"
  end
end

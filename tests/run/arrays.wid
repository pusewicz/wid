Vec2 = [2]F32

def sum(xs: []Int) -> Int
  total = 0
  for x in xs
    total += x
  end
  total
end

def main
  nums = [1, 2, 3, 4]
  puts nums.size
  puts nums[0] + nums[3]
  nums[1] = 20
  p nums
  puts sum(nums)
  puts sum(nums[1..2])
  puts sum(nums[1...3])
  for x, i in nums
    print i, ":", x, " "
  end
  puts
  for &x in nums
    x *= 2
  end
  p nums
  grid: [3][3]U8
  grid[1][1] = 5
  p grid[1]
  v: Vec2 = [3.0, 4.0]
  w = v * 2.0 + [1.0, 1.0]
  p w
  puts w.x
  puts w.y
  w.y = 0.5
  p w.yx
  p -v
  puts v == [3.0, 4.0]
  empty = nums[2...2]
  puts empty.size
  puts nums.first || 0
  puts nums.last || 0
end

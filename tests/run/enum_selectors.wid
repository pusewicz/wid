# `.name` names a member of the enum the context expects: in a declaration,
# an argument (with or without parentheses), a comparison, a `when`, a
# return, an array, an optional and an `Error`. A line that starts with
# `.name` is a value of its own unless it is indented deeper than its
# statement's first line, which doesn't open a block.
enum Dir : U8
  North
  East
  South
  West

  # On their own lines, after `when` and `else`.
  def turn -> Dir
    case self
    when .North
      .East
    when .East
      .South
    when .South
      .West
    else
      .North
    end
  end

  def name -> String
    case self
    when .North, .South then "vertical"
    else "horizontal"
    end
  end
end

enum Kind
  Struct
  Union
end

# The value of a method on its own line.
def start -> Dir
  .North
end

def step(d: Dir) -> Dir
  if d == .West
    return .North
  end
  d.turn
end

def show(d: Dir)
  puts "#{d.to_i} #{d.name}"
end

def find(n: Int) -> (Int, Error)
  return 0, .NotFound if n < 0
  return n, nil
end

macro def member(name: Symbol) -> Code
  quote do
    .#{name}
  end
end

macro def members(*names: Symbol) -> Code
  quote do
    [.#{names}]
  end
end

FACING: Dir = .South

def main
  d: Dir = .North
  show .East
  show(.South)
  show d.turn
  show start.turn.turn
  show step(.West)
  show FACING
  ds: [3]Dir = [.West, .East, d]
  p ds[0] == .West, ds[1] != .West
  maybe: Dir? = .South
  p maybe == .South
  _, err = find(-1)
  p err == .NotFound
  k: Kind = .Struct
  p k == .Union
  show member(:West)
  all: [2]Dir = members(:North, :West)
  p all[1] == .West
  # A line indented under its statement continues it.
  n = 5.to_f
    .to_i
  p n
end

# `.name` spaces like a value: after a keyword, an operator, a `,` or a
# call's name. A line that starts with `.name` keeps its own indentation
# level unless it continues the line above.
enum Dir
  North
  South

  def flip -> Dir
    case self
    when .North then .South
    else
      .North
    end
  end
end

def main
  d: Dir = .North
  p d == .South, [.North, .South]
  go .North
  go(.South)
  x = d
    .flip
end

  end
end

macro def listed(*names: Symbol = [:hp]) -> Code
  quote do
  end
end

def main
  puts sum(1, 2, 3)
  double = ->(*xs: Int) -> Int { xs.size * 2 }
  puts double.call([1, 2])
end

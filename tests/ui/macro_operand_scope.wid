# The statements a macro generates in an operand that may not run, never
# runs or runs on each test belong to that operand: the names they declare
# are visible only there (E0201 after it), and a `defer` there has no block
# to run at the end of (E0406).

macro def decl(n: Symbol) -> Code
  quote do
    #{n} = 5
    #{n} > 0
  end
end

macro def deferred(x: Bool) -> Code
  quote do
    defer puts("deferred ran")
    #{x}
  end
end

# A `defer` that a nested call generates is reported at that call.
macro def outer -> Code
  quote do
    deferred(true)
  end
end

struct Gate
  open: Bool

  def check(ok: Bool) -> Bool = @open && ok
end

def main
  gate: Gate? = nil
  a = false && decl(:aa)
  b = true || decl(:bb)
  c = false
  c ||= decl(:cc)
  d = type_info(decl(:dd))
  while decl(:ee)
    break
  end
  j = gate&.check(decl(:ff))
  case
  when a then puts "a"
  when decl(:gg) then puts "gg"
  end
  p a, b, c, d.name, j, aa, bb, cc, dd, ee, ff, gg

  e = false && deferred(true)
  f = true || deferred(true)
  g = false
  g ||= deferred(true)
  g &&= deferred(true)
  h = type_info(deferred(true))
  while deferred(false)
  end
  until deferred(true)
  end
  i = false && outer
  k = gate&.check(deferred(true))
  case
  when e then puts "e"
  when deferred(true) then puts "deferred"
  end
  p e, f, g, h.name, i, k
end

# `@name` assigned to when `name` is a method: a method can't be assigned
# to, and `name = …` would declare a variable instead, so there is no fix
# that drops the `@`. A field of a similar name is suggested.
struct Mob
  recovery: Int = 1
  def recover(n: Int) -> Int = n
end

struct P
  using mob: Mob
  hp: Int = 1
  heat: Int = 0
  def heal(n: Int) -> Int = n
  def plain(n: Int) -> Int = n

  def a
    @heal = 1
    @heal += 1
    @heal ||= 1
    @plain = 2
    @recover = 3
    x = 0
    @heal, x = 1, 2
    p x
  end
end

def main
  P.new.a
end

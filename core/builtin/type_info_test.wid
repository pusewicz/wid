import "core:testing"

struct Sample
  id: Int
  flag: U8
  next: ^Sample?
end

enum Level : I8
  low = -1
  high = 1
end

@[test]
def describes_struct_fields(t: ^testing.T)
  info = type_info(Sample)
  t.expect_eq(info.name, "Sample")
  t.expect_eq(info.kind, TypeKind.struct)
  t.expect_eq(info.size, 24)
  t.expect_eq(info.fields.size, 3)
  t.expect_eq(info.fields[1].name, "flag")
  t.expect_eq(info.fields[1].offset, 8)
  t.expect(info.fields[1].type == type_info(U8))
  t.expect_eq(info.fields[2].type.kind, TypeKind.optional)
end

@[test]
def describes_enum_members(t: ^testing.T)
  info = type_info(Level)
  t.expect_eq(info.kind, TypeKind.enum)
  t.expect_eq(info.members.size, 2)
  t.expect_eq(info.members[0].name, "low")
  t.expect_eq(info.members[0].value, -1)
  if backing = info.elem
    t.expect(backing == type_info(I8))
  else
    t.fail("an enum's elem is its backing type")
  end
end

@[test]
def same_type_same_table(t: ^testing.T)
  xs = [1, 2, 3]
  t.expect(type_info(xs) == type_info([3]Int))
  t.expect(type_info(xs[0]) == type_info(Int))
  t.expect(type_info(Sample) != type_info(Level))
end

@[test]
def describes_at_compile_time(t: ^testing.T)
  name = comptime type_info(Sample).fields[2].name
  kind = comptime type_info([]Level).kind
  t.expect_eq(name, "next")
  t.expect_eq(kind, TypeKind.slice)
end

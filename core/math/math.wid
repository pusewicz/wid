# core:math: constants, the C math library for `F32` and `F64`, interpolation
# helpers, and 2D/3D vector and rectangle helpers for games.

# π: half a turn, in radians.
PI = 3.141592653589793
# τ, or 2π: a full turn, in radians.
TAU = 6.283185307179586
# e, the base of the natural logarithm.
E = 2.718281828459045
# The square root of 2.
SQRT2 = 1.4142135623730951
# The natural logarithm of 2.
LN2 = 0.6931471805599453
# The natural logarithm of 10.
LN10 = 2.302585092994046
# The gap between 1 and the next `F32` above it.
F32_EPSILON = 1.1920929e-07
# The gap between 1 and the next `F64` above it.
F64_EPSILON = 2.220446049250313e-16

# Radians in one degree.
RAD_PER_DEG = 0.017453292519943295
# Degrees in one radian.
DEG_PER_RAD = 57.29577951308232

# The square root of `x`, for `F64` or `F32`.
overload :sqrt, :sqrt_f64, :sqrt_f32
# The cube root of `x`, for `F64` or `F32`.
overload :cbrt, :cbrt_f64, :cbrt_f32
# The sine of `x`, an angle in radians, for `F64` or `F32`.
overload :sin, :sin_f64, :sin_f32
# The cosine of `x`, an angle in radians, for `F64` or `F32`.
overload :cos, :cos_f64, :cos_f32
# The tangent of `x`, an angle in radians, for `F64` or `F32`.
overload :tan, :tan_f64, :tan_f32
# The arc sine of `x`, in radians from -π/2 to π/2, for `F64` or `F32`.
overload :asin, :asin_f64, :asin_f32
# The arc cosine of `x`, in radians from 0 to π, for `F64` or `F32`.
overload :acos, :acos_f64, :acos_f32
# The arc tangent of `x`, in radians from -π/2 to π/2, for `F64` or `F32`.
overload :atan, :atan_f64, :atan_f32
# The angle from the positive x axis to the point (`x`, `y`), in radians
# from -π to π, for `F64` or `F32`.
overload :atan2, :atan2_f64, :atan2_f32
# The hyperbolic sine of `x`, for `F64` or `F32`.
overload :sinh, :sinh_f64, :sinh_f32
# The hyperbolic cosine of `x`, for `F64` or `F32`.
overload :cosh, :cosh_f64, :cosh_f32
# The hyperbolic tangent of `x`, for `F64` or `F32`.
overload :tanh, :tanh_f64, :tanh_f32
# e raised to the power `x`, for `F64` or `F32`.
overload :exp, :exp_f64, :exp_f32
# 2 raised to the power `x`, for `F64` or `F32`.
overload :exp2, :exp2_f64, :exp2_f32
# The natural logarithm of `x`, for `F64` or `F32`.
overload :log, :log_f64, :log_f32
# The base-2 logarithm of `x`, for `F64` or `F32`.
overload :log2, :log2_f64, :log2_f32
# The base-10 logarithm of `x`, for `F64` or `F32`.
overload :log10, :log10_f64, :log10_f32
# `x` raised to the power `y`, for `F64` or `F32`.
overload :pow, :pow_f64, :pow_f32
# `x` rounded down to a whole number, for `F64` or `F32`.
overload :floor, :floor_f64, :floor_f32
# `x` rounded up to a whole number, for `F64` or `F32`.
overload :ceil, :ceil_f64, :ceil_f32
# `x` rounded to the nearest whole number, halfway cases away from zero,
# for `F64` or `F32`.
overload :round, :round_f64, :round_f32
# `x` rounded toward zero to a whole number, for `F64` or `F32`.
overload :trunc, :trunc_f64, :trunc_f32
# The length of the vector (`x`, `y`), without overflowing on the way,
# for `F64` or `F32`.
overload :hypot, :hypot_f64, :hypot_f32
# The remainder of `x / y`, with the sign of `x`, for `F64` or `F32`.
overload :fmod, :fmod_f64, :fmod_f32

# `a` when `t` is 0, `b` when `t` is 1, and in between (or beyond) otherwise.
def lerp(a: $T, b: T, t: T) -> T = a + (b - a) * t

# Where `v` lies between `a` and `b`: 0 at `a`, 1 at `b`.
def inverse_lerp(a: $T, b: T, v: T) -> T = (v - a) / (b - a)

# Maps `v` from the range `in_lo..in_hi` to `out_lo..out_hi`.
def remap(v: $T, in_lo: T, in_hi: T, out_lo: T, out_hi: T) -> T
  lerp(out_lo, out_hi, inverse_lerp(in_lo, in_hi, v))
end

# 0 below `edge0`, 1 above `edge1`, and a smooth curve in between.
def smoothstep(edge0: $T, edge1: T, x: T) -> T
  t = ((x - edge0) / (edge1 - edge0)).clamp(0.0, 1.0)
  t * t * (3.0 - 2.0 * t)
end

# Degrees to radians.
def to_radians(degrees: $T) -> T = degrees * RAD_PER_DEG

# Radians to degrees.
def to_degrees(radians: $T) -> T = radians * DEG_PER_RAD

# -1, 0 or 1, following the sign of `x`.
def sign(x: $T) -> T
  return 1 if x > 0
  return -1 if x < 0
  0
end

# Returns true when `a` and `b` differ by at most `tolerance`.
def close?(a: $T, b: T, tolerance: T) -> Bool = (a - b).abs <= tolerance

# Tells NaN and the infinities from the other floats.
extend F32, F64
  # Returns true for NaN, the only value not equal to itself.
  def nan? -> Bool = self != self

  # Returns true for positive or negative infinity.
  def infinite? -> Bool = !self.nan? && (self - self).nan?

  # Returns true for every value except NaN and the infinities.
  def finite? -> Bool = !(self - self).nan?
end

